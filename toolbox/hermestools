#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

HT_VERSION="1.0.0"
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
ROUTER_CONTAINER="${HERMESTOOLS_ROUTER_CONTAINER:-9router}"
ROUTER_IMAGE="${HERMESTOOLS_ROUTER_IMAGE:-decolua/9router:latest}"
ROUTER_PORT="${HERMESTOOLS_ROUTER_PORT:-20128}"
ROUTER_ROOT="http://127.0.0.1:${ROUTER_PORT}"
ROUTER_API="${ROUTER_ROOT}/v1"
ROUTER_DATA="${HERMESTOOLS_ROUTER_DATA:-$HOME/.9router}"
ROUTER_KEY_ENV="NINEROUTER_API_KEY"
GSK_SECRET_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hermestools"
GSK_KEY_FILE="${GSK_SECRET_DIR}/gsk_api_key"
SHARE_DIR="${HERMESTOOLS_SHARE_DIR:-/usr/local/share/hermestools}"
SKILL_SRC="${SHARE_DIR}/skills"

C_RESET='\033[0m'
C_CYAN='\033[1;36m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[1;31m'
C_BOLD='\033[1m'

info(){ printf "${C_CYAN}●${C_RESET} %s\n" "$*"; }
ok(){ printf "${C_GREEN}✓${C_RESET} %s\n" "$*"; }
warn(){ printf "${C_YELLOW}!${C_RESET} %s\n" "$*" >&2; }
die(){ printf "${C_RED}✗${C_RESET} %s\n" "$*" >&2; exit 1; }

banner() {
  printf "${C_BOLD}"
  cat <<'EOF'
╭──────────────────────────────────────────────╮
│        HermesLaunch — All-In AI Stack        │
│    Hermes + 9Router + Genspark + Skills      │
╰──────────────────────────────────────────────╯
EOF
  printf "${C_RESET}hermestools v%s\n\n" "$HT_VERSION"
}

run_root() {
  if [[ "$EUID" -eq 0 ]]; then
    "$@"
  else
    command -v sudo >/dev/null 2>&1 || die "Butuh root/sudo untuk operasi ini."
    sudo "$@"
  fi
}

need_tty() {
  [[ -r /dev/tty && -w /dev/tty ]] || die "Wizard membutuhkan TTY SSH biasa."
}

ask() {
  local __var="$1" prompt="$2" default="${3:-}" value=""
  if [[ -n "$default" ]]; then
    printf "%s [%s]: " "$prompt" "$default" > /dev/tty
  else
    printf "%s: " "$prompt" > /dev/tty
  fi
  IFS= read -r value < /dev/tty || true
  [[ -z "$value" ]] && value="$default"
  printf -v "$__var" '%s' "$value"
}

ask_secret() {
  local __var="$1" prompt="$2" value=""
  printf "%s: " "$prompt" > /dev/tty
  IFS= read -r -s value < /dev/tty || true
  printf "\n" > /dev/tty
  printf -v "$__var" '%s' "$value"
}

confirm() {
  local prompt="$1" default="${2:-N}" answer=""
  if [[ "$default" == "Y" ]]; then
    printf "%s [Y/n]: " "$prompt" > /dev/tty
  else
    printf "%s [y/N]: " "$prompt" > /dev/tty
  fi
  IFS= read -r answer < /dev/tty || true
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy]$ ]]
}

hermes_bin() {
  export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
  command -v hermes 2>/dev/null || true
}

require_hermes() {
  HERMES_BIN="$(hermes_bin)"
  [[ -n "$HERMES_BIN" ]] || die "Hermes belum ditemukan. Install Hermes/HermesLaunch terlebih dahulu."
  export HERMES_BIN
}

config_path() {
  "$HERMES_BIN" config path 2>/dev/null || printf '%s\n' "$HERMES_HOME/config.yaml"
}

env_path() {
  "$HERMES_BIN" config env-path 2>/dev/null || printf '%s\n' "$HERMES_HOME/.env"
}

backup_hermes() {
  require_hermes
  local ts dir cp ep
  ts="$(date +%Y%m%d-%H%M%S)"
  dir="$HERMES_HOME/backups/hermestools-$ts"
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  cp="$(config_path)"
  ep="$(env_path)"
  [[ -f "$cp" ]] && cp -a "$cp" "$dir/config.yaml"
  if [[ -f "$ep" ]]; then
    cp -a "$ep" "$dir/.env"
    chmod 600 "$dir/.env" 2>/dev/null || true
  fi
  printf '%s\n' "$dir"
}

restore_hermes_backup() {
  local dir="$1" cp ep
  cp="$(config_path)"
  ep="$(env_path)"
  [[ -f "$dir/config.yaml" ]] && cp -a "$dir/config.yaml" "$cp"
  [[ -f "$dir/.env" ]] && {
    cp -a "$dir/.env" "$ep"
    chmod 600 "$ep" 2>/dev/null || true
  }
}

dotenv_set() {
  local key="$1" value="$2" ep
  ep="$(env_path)"
  mkdir -p "$(dirname "$ep")"
  touch "$ep"
  chmod 600 "$ep" 2>/dev/null || true
  KEY="$key" VALUE="$value" FILE="$ep" python3 - <<'PY'
import json, os, re
from pathlib import Path

p = Path(os.environ["FILE"])
key = os.environ["KEY"]
value = os.environ["VALUE"]

if "\n" in value or "\r" in value:
    raise SystemExit("Secret contains newline")

lines = p.read_text(encoding="utf-8").splitlines() if p.exists() else []
pat = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
new_line = f"{key}={json.dumps(value, ensure_ascii=False)}"

out = []
done = False
for line in lines:
    if pat.match(line):
        if not done:
            out.append(new_line)
            done = True
    else:
        out.append(line)
if not done:
    out.append(new_line)

p.write_text("\n".join(out).rstrip() + "\n", encoding="utf-8")
os.chmod(p, 0o600)
PY
}

dotenv_get() {
  local key="$1" ep
  ep="$(env_path)"
  [[ -f "$ep" ]] || return 0
  KEY="$key" FILE="$ep" python3 - <<'PY'
import json, os, re
from pathlib import Path

p = Path(os.environ["FILE"])
key = os.environ["KEY"]
if not p.exists():
    raise SystemExit

pat = re.compile(r"^\s*" + re.escape(key) + r"\s*=(.*)$")
for line in p.read_text(encoding="utf-8").splitlines():
    m = pat.match(line)
    if not m:
        continue
    raw = m.group(1).strip()
    try:
        if raw.startswith('"'):
            print(json.loads(raw))
        elif raw.startswith("'") and raw.endswith("'"):
            print(raw[1:-1])
        else:
            print(raw)
    except Exception:
        print(raw.strip("\"'"))
    break
PY
}

restart_gateway() {
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q '^hermes-gateway\.service'; then
    run_root systemctl restart hermes-gateway.service
    sleep 2
  else
    warn "hermes-gateway.service tidak ditemukan; lakukan /reset atau restart gateway manual."
  fi
}

install_base_packages() {
  info "Memeriksa dependency..."
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -y
    DEBIAN_FRONTEND=noninteractive run_root apt-get install -y ca-certificates curl jq python3
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y ca-certificates curl jq python3
  elif command -v yum >/dev/null 2>&1; then
    run_root yum install -y ca-certificates curl jq python3
  else
    command -v curl >/dev/null 2>&1 || die "curl belum tersedia."
    command -v python3 >/dev/null 2>&1 || die "python3 belum tersedia."
  fi
  ok "Dependency dasar siap"
}

docker_install() {
  if command -v docker >/dev/null 2>&1; then
    ok "Docker sudah tersedia"
    run_root systemctl enable --now docker 2>/dev/null || true
    return
  fi

  info "Menginstall Docker..."
  if command -v apt-get >/dev/null 2>&1; then
    run_root apt-get update -y
    DEBIAN_FRONTEND=noninteractive run_root apt-get install -y docker.io
  elif command -v dnf >/dev/null 2>&1; then
    run_root dnf install -y docker
  elif command -v yum >/dev/null 2>&1; then
    run_root yum install -y docker
  else
    die "Auto-install Docker saat ini mendukung apt/dnf/yum."
  fi

  run_root systemctl enable --now docker
  command -v docker >/dev/null 2>&1 || die "Docker gagal terinstall."
  ok "Docker siap"
}

router_exists() {
  run_root docker inspect "$ROUTER_CONTAINER" >/dev/null 2>&1
}

router_running() {
  [[ "$(run_root docker inspect -f '{{.State.Running}}' "$ROUTER_CONTAINER" 2>/dev/null || true)" == "true" ]]
}

router_binding() {
  run_root docker port "$ROUTER_CONTAINER" "${ROUTER_PORT}/tcp" 2>/dev/null | head -n 1 || true
}

router_run_new() {
  mkdir -p "$ROUTER_DATA"
  chmod 700 "$ROUTER_DATA" 2>/dev/null || true
  run_root docker run -d \
    --name "$ROUTER_CONTAINER" \
    --restart unless-stopped \
    -p "127.0.0.1:${ROUTER_PORT}:20128" \
    -v "${ROUTER_DATA}:/app/data" \
    -e DATA_DIR=/app/data \
    "$ROUTER_IMAGE" >/dev/null
}

router_wait() {
  local i code
  for i in $(seq 1 30); do
    code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 3 "${ROUTER_ROOT}/dashboard" || true)"
    if [[ "$code" != "000" && -n "$code" ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

router_install() {
  docker_install
  info "Menyiapkan 9Router..."

  if router_exists; then
    local binding
    binding="$(router_binding)"
    if [[ "$binding" == 127.0.0.1:* || "$binding" == "[::1]:"* ]]; then
      router_running || run_root docker start "$ROUTER_CONTAINER" >/dev/null
      ok "Container 9Router sudah ada dan localhost-only"
    else
      warn "Container '$ROUTER_CONTAINER' sudah ada dengan binding: ${binding:-unknown}"
      warn "HermesTools tidak merecreate container existing agar data kamu tidak berisiko hilang."
      warn "Pastikan dashboard tidak diekspos publik tanpa proteksi."
      router_running || run_root docker start "$ROUTER_CONTAINER" >/dev/null || true
    fi
  else
    run_root docker pull "$ROUTER_IMAGE"
    router_run_new
    ok "Container 9Router dibuat"
  fi

  if router_wait; then
    ok "9Router reachable di ${ROUTER_ROOT}"
  else
    warn "9Router belum menjawab setelah timeout. Cek: hermestools router logs"
  fi
}

router_dashboard() {
  cat <<EOF

9Router dashboard dikunci ke localhost VPS.

Dari Termux/komputer lokal buka SSH tunnel:

  ssh -L ${ROUTER_PORT}:127.0.0.1:${ROUTER_PORT} USER@IP_VPS

Lalu buka browser lokal:

  http://127.0.0.1:${ROUTER_PORT}/dashboard

Di dashboard:
  1. Connect provider yang kamu inginkan (mis. OpenCode Free)
  2. Buat/copy API key 9Router
  3. Kembali ke VPS
  4. Jalankan: hermestools router link

Jangan kirim API key ke orang lain.
EOF
}

router_key() {
  dotenv_get "$ROUTER_KEY_ENV" || true
}

router_models_raw() {
  local key
  key="$(router_key)"
  [[ -n "$key" ]] || return 1
  curl -fsS --connect-timeout 5 --max-time 20 \
    -H "Authorization: Bearer $key" \
    -H "Accept: application/json" \
    "${ROUTER_API}/models"
}

router_models() {
  local raw
  raw="$(router_models_raw 2>/dev/null || true)"
  if [[ -z "$raw" ]]; then
    warn "Belum bisa membaca model. Jalankan 'hermestools router link' setelah punya API key."
    return 1
  fi

  RAW_MODELS="$raw" python3 - <<'PY'
import json, os
try:
    data = json.loads(os.environ["RAW_MODELS"])
except Exception:
    raise SystemExit(1)

rows = data.get("data", data if isinstance(data, list) else [])
found = []
for item in rows:
    if isinstance(item, dict) and item.get("id"):
        found.append(str(item["id"]))
    elif isinstance(item, str):
        found.append(item)
for model in found:
    print(model)
PY
}

router_link() {
  require_hermes
  need_tty
  install_base_packages
  router_install

  local key backup model models first
  printf "\n${C_BOLD}Link 9Router → Hermes${C_RESET}\n" > /dev/tty
  ask_secret key "API key 9Router (input disembunyikan)"
  [[ -n "$key" ]] || die "API key tidak boleh kosong."

  backup="$(backup_hermes)"
  dotenv_set "$ROUTER_KEY_ENV" "$key"

  "$HERMES_BIN" config set "providers.9router.api" "$ROUTER_API"
  "$HERMES_BIN" config set "providers.9router.name" "9Router"
  "$HERMES_BIN" config set "providers.9router.key_env" "$ROUTER_KEY_ENV"
  "$HERMES_BIN" config set "providers.9router.transport" "chat_completions"
  "$HERMES_BIN" config set "providers.9router.discover_models" "true"

  models="$(router_models 2>/dev/null || true)"
  first="$(printf '%s\n' "$models" | sed -n '1p')"

  if [[ -n "$models" ]]; then
    printf "\nModel terdeteksi:\n" > /dev/tty
    printf '%s\n' "$models" | head -n 30 | nl -w2 -s'. ' > /dev/tty
    printf "\n" > /dev/tty
  else
    warn "Endpoint /models belum memberi daftar model. Kamu bisa isi Model ID manual."
  fi

  ask model "Default Model ID untuk provider 9Router" "$first"
  [[ -n "$model" ]] || die "Model ID wajib diisi."
  "$HERMES_BIN" config set "providers.9router.default_model" "$model"

  if ! "$HERMES_BIN" config check; then
    warn "Config Hermes gagal validasi. Mengembalikan backup..."
    restore_hermes_backup "$backup"
    die "Link 9Router dibatalkan; config lama dipulihkan."
  fi

  ok "9Router terdaftar sebagai named custom provider: custom:9router"
  printf "Provider aktif Hermes saat ini TIDAK diubah.\n" > /dev/tty

  if confirm "Aktifkan 9Router sekarang?" "N"; then
    "$HERMES_BIN" config set "model.provider" "custom:9router"
    "$HERMES_BIN" config set "model.default" "$model"
    "$HERMES_BIN" config check || {
      restore_hermes_backup "$backup"
      die "Switch gagal; backup dipulihkan."
    }
    restart_gateway
    ok "Hermes sekarang memakai 9Router / $model"
  else
    restart_gateway
    ok "Provider lama tetap aktif. Nanti pilih 9Router lewat /model."
  fi

  echo "Backup sebelum perubahan: $backup"
}

router_use() {
  require_hermes
  local model="${1:-}"
  [[ -n "$model" ]] || {
    router_models || true
    echo
    echo "Usage: hermestools router use <MODEL_ID>"
    return 2
  }

  local backup
  backup="$(backup_hermes)"
  "$HERMES_BIN" config set "model.provider" "custom:9router"
  "$HERMES_BIN" config set "model.default" "$model"
  if "$HERMES_BIN" config check; then
    restart_gateway
    ok "Aktif: custom:9router / $model"
  else
    restore_hermes_backup "$backup"
    die "Config check gagal; backup dipulihkan."
  fi
}

router_status() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "9Router: Docker belum terinstall"
    return 1
  fi
  if ! router_exists; then
    echo "9Router: container belum dibuat"
    return 1
  fi
  echo "Container : $ROUTER_CONTAINER"
  echo "Running   : $(router_running && echo yes || echo no)"
  echo "Binding   : $(router_binding)"
  echo "API       : $ROUTER_API"
  local code
  code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 4 "${ROUTER_ROOT}/dashboard" || true)"
  echo "HTTP      : ${code:-N/A}"
  local hb
  hb="$(hermes_bin)"
  if [[ -n "$hb" ]]; then
    echo "Hermes provider entry:"
    "$hb" config get providers.9router 2>/dev/null || echo "  not linked yet"
  fi
}

router_logs() {
  command -v docker >/dev/null 2>&1 || die "Docker belum terinstall."
  run_root docker logs --tail "${1:-100}" "$ROUTER_CONTAINER"
}

router_start() {
  run_root docker start "$ROUTER_CONTAINER" >/dev/null
  router_wait || true
  router_status
}

router_stop() {
  run_root docker stop "$ROUTER_CONTAINER" >/dev/null
  ok "9Router stopped"
}

router_restart() {
  run_root docker restart "$ROUTER_CONTAINER" >/dev/null
  router_wait || true
  router_status
}

router_update() {
  need_tty
  docker_install
  confirm "Update 9Router ke image latest? Data ~/.9router dipertahankan." "N" || return 0
  run_root docker pull "$ROUTER_IMAGE"

  if router_exists; then
    local binding
    binding="$(router_binding)"
    run_root docker rm -f "$ROUTER_CONTAINER" >/dev/null
    if [[ "$binding" == 127.0.0.1:* || -z "$binding" ]]; then
      router_run_new
    else
      warn "Container lama tidak localhost-only; versi baru dibuat localhost-only."
      router_run_new
    fi
  else
    router_run_new
  fi
  router_wait || true
  ok "9Router updated"
}

node_major() {
  command -v node >/dev/null 2>&1 || return 1
  node -p 'process.versions.node.split(".")[0]' 2>/dev/null
}

genspark_install() {
  info "Menyiapkan Genspark CLI..."
  local major
  major="$(node_major || true)"
  if [[ -z "$major" ]]; then
    if command -v apt-get >/dev/null 2>&1; then
      run_root apt-get update -y
      DEBIAN_FRONTEND=noninteractive run_root apt-get install -y nodejs npm
    elif command -v dnf >/dev/null 2>&1; then
      run_root dnf install -y nodejs npm
    elif command -v yum >/dev/null 2>&1; then
      run_root yum install -y nodejs npm
    else
      die "Node.js >=18 dibutuhkan Genspark CLI."
    fi
    major="$(node_major || true)"
  fi

  [[ "$major" =~ ^[0-9]+$ ]] || die "Versi Node.js tidak bisa dibaca."
  (( major >= 18 )) || die "Genspark CLI butuh Node.js >=18; Node saat ini v$(node -v)."

  run_root npm install -g @genspark/cli
  command -v gsk >/dev/null 2>&1 || die "Install @genspark/cli selesai tetapi command gsk tidak ditemukan."

  mkdir -p "$GSK_SECRET_DIR"
  chmod 700 "$GSK_SECRET_DIR" 2>/dev/null || true

  local wrapper
  wrapper="$(mktemp)"
  cat > "$wrapper" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
KEY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hermestools/gsk_api_key"
if [[ -s "$KEY_FILE" ]]; then
  IFS= read -r GSK_API_KEY < "$KEY_FILE"
  export GSK_API_KEY
fi
exec gsk "$@"
EOF
  chmod 755 "$wrapper"
  run_root install -m 0755 "$wrapper" /usr/local/bin/gskh
  rm -f "$wrapper"

  ok "Genspark CLI siap: $(gsk --version 2>/dev/null || echo installed)"
}

genspark_auth() {
  need_tty
  install_base_packages
  genspark_install
  local choice key
  echo
  echo "Genspark Authentication"
  echo "1. Login browser resmi (gsk login)"
  echo "2. Simpan GSK API key lokal (mode 600)"
  echo "3. Nanti saja"
  printf "Pilih [1-3]: " > /dev/tty
  IFS= read -r choice < /dev/tty || true

  case "$choice" in
    1)
      gsk login
      ;;
    2)
      ask_secret key "GSK API key"
      [[ -n "$key" ]] || die "API key kosong."
      mkdir -p "$GSK_SECRET_DIR"
      chmod 700 "$GSK_SECRET_DIR"
      printf '%s\n' "$key" > "$GSK_KEY_FILE"
      chmod 600 "$GSK_KEY_FILE"
      ok "GSK API key tersimpan lokal; nilainya tidak ditampilkan."
      ;;
    3|"")
      warn "Autentikasi Genspark dilewati."
      return 0
      ;;
    *)
      die "Pilihan tidak valid."
      ;;
  esac

  genspark_test || true
}

genspark_test() {
  command -v gskh >/dev/null 2>&1 || die "Genspark belum terinstall."
  info "Mengecek identitas Genspark..."
  if gskh me; then
    ok "Genspark authentication OK"
  else
    warn "Genspark belum login / API key belum valid."
    return 1
  fi
}

genspark_sync() {
  require_hermes
  install_base_packages
  command -v gsk >/dev/null 2>&1 || genspark_install
  local ref="$HERMES_HOME/skills/research/genspark/reference"
  mkdir -p "$ref"

  info "Sinkronisasi dokumentasi skill Genspark..."
  if gsk init-skills -o "$ref"; then
    ok "Genspark reference skills disinkronkan"
  else
    warn "gsk init-skills gagal; skill wrapper Hermes tetap tersedia."
  fi
}

skills_refresh() {
  require_hermes
  [[ -d "$SKILL_SRC" ]] || die "Skill source tidak ditemukan: $SKILL_SRC"
  mkdir -p "$HERMES_HOME/skills/research" "$HERMES_HOME/skills/infrastructure"

  cp -a "$SKILL_SRC/research/genspark" "$HERMES_HOME/skills/research/"
  cp -a "$SKILL_SRC/infrastructure/router9" "$HERMES_HOME/skills/infrastructure/"
  cp -a "$SKILL_SRC/infrastructure/ai-stack" "$HERMES_HOME/skills/infrastructure/"

  ok "Hermes skills terpasang"
  echo "Gunakan session baru atau /reset agar skill index dibaca ulang."
}

stack_status() {
  require_hermes
  echo "HermesLaunch All-In AI Stack"
  echo "────────────────────────────────────────"
  echo "Hermes       : $("$HERMES_BIN" --version 2>/dev/null | head -n1 || echo installed)"
  if command -v systemctl >/dev/null 2>&1; then
    echo "Gateway      : $(systemctl is-active hermes-gateway.service 2>/dev/null || echo unknown)"
  fi
  echo "Active prov. : $("$HERMES_BIN" config get model.provider 2>/dev/null || echo unknown)"
  echo "Active model : $("$HERMES_BIN" config get model.default 2>/dev/null || echo unknown)"
  echo
  router_status 2>/dev/null || true
  echo
  echo "Genspark CLI : $(command -v gsk >/dev/null 2>&1 && (gsk --version 2>/dev/null || echo installed) || echo not-installed)"
  echo "GSK auth     : $(command -v gskh >/dev/null 2>&1 && gskh me >/dev/null 2>&1 && echo ready || echo pending)"
  echo "Genspark skill: $([[ -f "$HERMES_HOME/skills/research/genspark/SKILL.md" ]] && echo installed || echo missing)"
  echo "Router skill  : $([[ -f "$HERMES_HOME/skills/infrastructure/router9/SKILL.md" ]] && echo installed || echo missing)"
}

doctor() {
  require_hermes
  local failed=0
  echo "HermesTools Doctor"
  echo "────────────────────────────────────────"
  for c in curl python3 hermes; do
    if command -v "$c" >/dev/null 2>&1; then
      echo "✓ $c"
    else
      echo "✗ $c"
      failed=1
    fi
  done

  if command -v docker >/dev/null 2>&1; then
    echo "✓ docker"
  else
    echo "! docker (9Router belum dapat berjalan)"
    failed=1
  fi

  if command -v gsk >/dev/null 2>&1; then
    echo "✓ gsk"
  else
    echo "! gsk"
    failed=1
  fi

  "$HERMES_BIN" config check >/dev/null 2>&1 && echo "✓ Hermes config" || {
    echo "✗ Hermes config"
    failed=1
  }

  router_running && echo "✓ 9Router container" || {
    echo "! 9Router container"
    failed=1
  }

  [[ -f "$HERMES_HOME/skills/research/genspark/SKILL.md" ]] && echo "✓ Genspark skill" || {
    echo "! Genspark skill"
    failed=1
  }

  return "$failed"
}

setup_all() {
  banner
  require_hermes
  need_tty
  install_base_packages
  local backup
  backup="$(backup_hermes)"
  echo "Hermes backup: $backup"

  router_install
  genspark_install
  skills_refresh
  genspark_sync || true

  echo
  printf "${C_GREEN}${C_BOLD}Auto-install infrastructure selesai.${C_RESET}\n"
  echo "Provider Hermes lama belum diubah."

  echo
  if confirm "Sudah connect provider di dashboard 9Router dan punya API key? Link ke Hermes sekarang?" "N"; then
    router_link
  else
    router_dashboard
  fi

  echo
  if confirm "Autentikasi Genspark sekarang?" "Y"; then
    genspark_auth
  else
    warn "Genspark auth pending. Nanti: hermestools genspark auth"
  fi

  restart_gateway || true
  echo
  stack_status
  echo
  echo "Di Telegram gunakan /reset agar skill baru langsung terbaca."
}

router_menu() {
  need_tty
  local c
  while true; do
    echo
    echo "9Router"
    echo "1. Install / repair"
    echo "2. Dashboard tunnel info"
    echo "3. Link ke Hermes"
    echo "4. List models"
    echo "5. Status"
    echo "6. Logs"
    echo "7. Restart"
    echo "8. Update"
    echo "9. Back"
    printf "Pilih [1-9]: " > /dev/tty
    IFS= read -r c < /dev/tty || true
    case "$c" in
      1) router_install ;;
      2) router_dashboard ;;
      3) router_link ;;
      4) router_models || true ;;
      5) router_status || true ;;
      6) router_logs ;;
      7) router_restart ;;
      8) router_update ;;
      9|"") return ;;
      *) echo "Pilihan tidak valid." ;;
    esac
  done
}

genspark_menu() {
  need_tty
  local c
  while true; do
    echo
    echo "Genspark"
    echo "1. Install / update CLI"
    echo "2. Authenticate"
    echo "3. Test account"
    echo "4. Sync skill docs"
    echo "5. Search"
    echo "6. Back"
    printf "Pilih [1-6]: " > /dev/tty
    IFS= read -r c < /dev/tty || true
    case "$c" in
      1) genspark_install ;;
      2) genspark_auth ;;
      3) genspark_test || true ;;
      4) genspark_sync ;;
      5)
        local q
        ask q "Search query" ""
        [[ -n "$q" ]] && gskh search "$q" || true
        ;;
      6|"") return ;;
      *) echo "Pilihan tidak valid." ;;
    esac
  done
}

main_menu() {
  need_tty
  local c
  while true; do
    banner
    echo "1. Setup / repair ALL"
    echo "2. Status"
    echo "3. 9Router Manager"
    echo "4. Genspark Manager"
    echo "5. Refresh Hermes skills"
    echo "6. Doctor"
    echo "7. Exit"
    printf "Pilih [1-7]: " > /dev/tty
    IFS= read -r c < /dev/tty || true
    case "$c" in
      1) setup_all ;;
      2) stack_status ;;
      3) router_menu ;;
      4) genspark_menu ;;
      5) skills_refresh ;;
      6) doctor || true ;;
      7|"") return ;;
      *) echo "Pilihan tidak valid." ;;
    esac
    printf "\nTekan Enter..." > /dev/tty
    IFS= read -r _ < /dev/tty || true
  done
}

help_text() {
  cat <<'EOF'
HermesTools — HermesLaunch All-In AI Stack

Usage:
  hermestools
  hermestools setup
  hermestools status
  hermestools doctor

  hermestools router
  hermestools router install
  hermestools router dashboard
  hermestools router link
  hermestools router models
  hermestools router use <MODEL_ID>
  hermestools router status
  hermestools router logs [N]
  hermestools router restart
  hermestools router update

  hermestools genspark
  hermestools genspark install
  hermestools genspark auth
  hermestools genspark test
  hermestools genspark sync
  hermestools genspark search "query"

  hermestools skills refresh
  hermestools version

Security:
  - 9Router is created on 127.0.0.1:20128 only.
  - Existing Hermes provider remains active unless you explicitly switch.
  - Provider config is backed up before linking/switching.
  - Genspark API key file is chmod 600 and never printed.
EOF
}

case "${1:-menu}" in
  menu|"") main_menu ;;
  setup|install|all) setup_all ;;
  status) stack_status ;;
  doctor) doctor ;;
  router|9router)
    case "${2:-menu}" in
      menu|"") router_menu ;;
      install|repair) router_install ;;
      dashboard|tunnel) router_dashboard ;;
      link|configure) router_link ;;
      models|list-models) router_models ;;
      use|switch) router_use "${3:-}" ;;
      status) router_status ;;
      logs) router_logs "${3:-100}" ;;
      start) router_start ;;
      stop) router_stop ;;
      restart) router_restart ;;
      update) router_update ;;
      *) help_text; exit 2 ;;
    esac
    ;;
  genspark|gsk)
    case "${2:-menu}" in
      menu|"") genspark_menu ;;
      install|update) genspark_install ;;
      auth|login) genspark_auth ;;
      test|me) genspark_test ;;
      sync|skills) genspark_sync ;;
      search)
        shift 2
        [[ "$#" -gt 0 ]] || { echo 'Usage: hermestools genspark search "query"'; exit 2; }
        gskh search "$*"
        ;;
      *) help_text; exit 2 ;;
    esac
    ;;
  skills)
    case "${2:-refresh}" in
      refresh|install|sync) skills_refresh ;;
      *) help_text; exit 2 ;;
    esac
    ;;
  version) echo "hermestools v$HT_VERSION" ;;
  help|-h|--help) help_text ;;
  *) help_text; exit 2 ;;
esac
